 "id": "hoje-sumiu-dia04",
 "dia": 4,
 "coisa": "a energia",
 "velocidade": 1,
 "falas": [
  {
   "fala": "Hoje sumiu a energia.",
   "legenda": "Hoje sumiu a ~energia.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo *inteiro.* Para *sempre.*",
   "segura": 0.2
  },
  {
   "fala": "Esse foi o comentário mais curtido.",
   "legenda": "Esse foi o comentário *mais curtido.*",
   "segura": 0.5
  },
  {
   "fala": "Primeiro, o celular. Ele morreu no meio da mensagem.",
   "legenda": "Primeiro, o *celular.* Ele *morreu* no meio da *mensagem.*",
   "segura": 0.3
  },
  {
   "fala": "Depois, o semáforo. Sem luz, todo carro acha que é o primeiro.",
   "legenda": "Depois, o *semáforo.* Sem *luz,* todo carro acha que é o *primeiro.*",
   "segura": 0.3
  },
  {
   "fala": "A novela das oito parou no beijo. A casa inteira ficou em silêncio.",
   "legenda": "A *novela* das oito parou no *beijo.* A casa inteira ficou em *silêncio.*",
   "segura": 0.35
  },
  {
   "fala": "À noite, a cidade fica escura. E as estrelas aparecem.",
   "legenda": "À noite, a cidade fica *escura.* E as *estrelas* aparecem.",
   "segura": 0.4
  },
  {
   "fala": "Feito só com inteligência artificial, sem câmera. Quer aprender? O guia está no línque da bio.",
   "legenda": "Feito só com *inteligência artificial,* sem *câmera.* Quer *aprender?* O *guia* está no *link* da *bio.*",
   "segura": 0.2
  },
  {
   "fala": "Voltando. Só uma coisa não mudou. Sua mãe continua gritando: apaga a luz!",
   "legenda": "Voltando. Só uma coisa não *mudou.* Sua *mãe* continua *gritando:* apaga a *luz!*",
   "segura": 0.45
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, a energia nunca existiu.",
   "legenda": "Mas ninguém *reclama.* Para todo mundo, a ~energia~ *nunca existiu.*",
   "segura": 0.4
  },
  {
   "fala": "Só o Seu Nilo lembra. A regra dele é clara: aqui não some governo nem pessoa. E ele anotou: dia quatro, a energia.",
   "legenda": "Só o *Seu Nilo* lembra. A regra dele é clara: aqui não some *governo* nem *pessoa.* E ele *anotou:* *dia 4,* a ~energia.~",
   "segura": 0.35
  },
  {
   "fala": "Amanhã, outra coisa vai sumir. E quem escolhe é você.",
   "legenda": "*Amanhã,* outra coisa vai sumir. E quem escolhe é *você.*"
  },
  {
   "fala": "Comenta aqui embaixo. O comentário mais curtido some do mundo.",
   "legenda": "*Comenta* aqui embaixo. O comentário mais curtido *some* do mundo."
  }
