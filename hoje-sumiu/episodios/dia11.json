 "falas": [
  {
   "fala": "Hoje sumiram os espelhos.",
   "legenda": "Hoje sumiram os ~espelhos.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo inteiro. Para *sempre.*"
  },
  {
   "fala": "O comentário mais curtido foi os espelhos.",
   "legenda": "O comentário mais *curtido* foi os *espelhos.*"
  },
  {
   "fala": "Primeira manhã: ninguém sabe como está o rosto.",
   "legenda": "Primeira manhã: ninguém sabe como está o *rosto.*"
  },
  {
   "fala": "O barbeiro corta no escuro.",
   "legenda": "O *barbeiro* corta no *escuro.*"
  },
  {
   "fala": "O dentista trata o dente errado.",
   "legenda": "O *dentista* trata o dente *errado.*"
  },
  {
   "fala": "Em uma semana, a maquiagem vira arte moderna.",
   "legenda": "Em uma semana, a *maquiagem* vira *arte* moderna."
  },
  {
   "fala": "Em duas semanas, o pavão do parque perde a graça.",
   "legenda": "Em duas semanas, o *pavão* do parque perde a *graça.*"
  },
  {
   "fala": "Feito sem câmera. Comente GUIA.",
   "legenda": "*Feito* sem *câmera.* Comente *GUIA.*"
  },
  {
   "fala": "Em um mês, um amigo vira o espelho do outro.",
   "legenda": "Em um mês, um *amigo* vira o *espelho* do outro."
  },
  {
   "fala": "Em três meses, o rio vira o espelho da cidade.",
   "legenda": "Em três meses, o *rio* vira o *espelho* da cidade."
  },
  {
   "fala": "No fim, até o reflexo na água some.",
   "legenda": "No fim, até o *reflexo* na água *some.*"
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, espelho nunca existiu.",
   "legenda": "Mas ninguém reclama. Para todo mundo, espelho *nunca existiu.*"
  },
  {
   "fala": "Só o Seu Nilo lembra. Ele anotou.",
   "legenda": "Só o *Seu Nilo* lembra. Ele *anotou.*",
   "segura": 1.4
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "Amanhã, outra coisa vai *sumir.*"
  },
  {
   "fala": "Quem escolhe é você. Comente o que some amanhã. O mais curtido decide.",
