 "falas": [
  { "fala": "Hoje sumiu as placas.", "legenda": "Hoje sumiu as ~placas.~" },
  { "fala": "Do mundo inteiro. Para sempre.", "legenda": "Do mundo *inteiro.* Para *sempre.*", "segura": 0.2 },
  { "fala": "Esse foi o comentário mais curtido.", "legenda": "Esse foi o comentário *mais curtido.*", "segura": 0.5 },
  { "fala": "Primeiro, as placas de trânsito. Ninguém sabe se pode virar.", "legenda": "Primeiro, as placas de *trânsito.* Ninguém sabe se *pode* virar.", "segura": 0.3 },
  { "fala": "Depois, o nome da padaria. Todo mundo entrou na loja errada.", "legenda": "Depois, o nome da *padaria.* Todo mundo entrou na loja *errada.*", "segura": 0.3 },
  { "fala": "No shopping, a placa de saída sumiu. Tem gente lá até hoje.", "legenda": "No *shopping,* a placa de saída *sumiu.* Tem gente lá até *hoje.*", "segura": 0.35 },
  { "fala": "O carteiro desistiu. Entregou todas as cartas na mesma casa.", "legenda": "O *carteiro* desistiu. Entregou todas as *cartas* na *mesma* casa.", "segura": 0.35 },
  { "fala": "Feito sem câmera. O guia está no línque da bio.", "legenda": "Feito sem *câmera.* O *guia* está no *link* da *bio.*", "segura": 0.2 },
  { "fala": "Voltando. Só uma coisa não mudou. O vizinho continua parando na sua vaga.", "legenda": "Voltando. Só uma coisa não *mudou.* O *vizinho* continua parando na sua *vaga.*", "segura": 0.45 },
  { "fala": "Mas ninguém reclama. Para todo mundo, as placas nunca existiram.", "legenda": "Mas ninguém *reclama.* Para todo mundo, as ~placas~ *nunca existiram.*", "segura": 0.4 },
  { "fala": "Só o Seu Nilo lembra. A regra dele é clara: aqui não some governo nem pessoa. E ele anotou: dia cinco, as placas.", "legenda": "Só o *Seu Nilo* lembra. A regra dele é clara: aqui não some *governo* nem *pessoa.* E ele *anotou:* *dia 5,* as ~placas.~", "segura": 0.35 },
  { "fala": "Amanhã, outra coisa vai sumir. E quem escolhe é você.", "legenda": "*Amanhã,* outra coisa vai sumir. E quem escolhe é *você.*" },
  { "fala": "Comenta aqui embaixo. O comentário mais curtido some do mundo.", "legenda": "*Comenta* aqui embaixo. O comentário mais curtido *some* do mundo." }
