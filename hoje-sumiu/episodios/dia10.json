  {
   "fala": "Hoje sumiu o chuveiro quente.",
   "legenda": "Hoje sumiu o ~chuveiro~ ~quente.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo inteiro. Para *sempre.*"
  },
  {
   "fala": "Vocês votaram nas janelas. Mas sem casas, janela não faz sentido.",
   "legenda": "Vocês votaram nas *janelas.* Mas sem *casas,* janela não faz sentido."
  },
  {
   "fala": "Foi erro meu dar essa opção. Então vale o segundo mais votado.",
   "legenda": "Foi *erro* meu dar essa opção. Então vale o *segundo* mais votado."
  },
  {
   "fala": "Primeira manhã: o banho vira fila na fonte.",
   "legenda": "Primeira manhã: o *banho* vira *fila* na fonte."
  },
  {
   "fala": "Ninguém canta mais no banho.",
   "legenda": "Ninguém *canta* mais no *banho.*"
  },
  {
   "fala": "O sabonete vira enfeite.",
   "legenda": "O *sabonete* vira *enfeite.*"
  },
  {
   "fala": "Feito sem câmera. Comente GUIA.",
   "legenda": "*Feito* sem *câmera.* Comente *GUIA.*"
  },
  {
   "fala": "Em uma semana, o cabelo vira o assunto.",
   "legenda": "Em uma semana, o *cabelo* vira o assunto."
  },
  {
   "fala": "Em um mês, os patos da fonte reclamam da fila.",
   "legenda": "Em um mês, os *patos* da fonte reclamam da fila."
  },
  {
   "fala": "Em três meses, todo mundo inventa um chapéu.",
   "legenda": "Em três meses, todo mundo inventa um *chapéu.*"
  },
  {
   "fala": "No fim, o rio vira o chuveiro da cidade inteira.",
   "legenda": "No fim, o *rio* vira o chuveiro da cidade inteira."
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, o chuveiro quente nunca existiu.",
   "legenda": "Mas ninguém reclama. Para todo mundo, o chuveiro quente *nunca existiu.*"
  },
  {
   "fala": "Só o Seu Nilo lembra. Ele anotou.",
   "legenda": "Só o *Seu Nilo* lembra. Ele *anotou.*"
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "Amanhã, outra coisa vai *sumir.*"
  },
  {
   "fala": "Quem escolhe é você. Comente o que some amanhã. O mais curtido decide.",
