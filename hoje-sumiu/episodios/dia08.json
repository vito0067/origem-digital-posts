 "falas": [
  {
   "fala": "Hoje sumiu o sono.",
   "legenda": "Hoje sumiu o ~sono.~"
  },
  {
   "fala": "Ninguém mais dorme. Nunca mais.",
   "legenda": "Ninguém mais *dorme.* Nunca *mais.*",
   "segura": 0.15
  },
  {
   "fala": "Pedido de vocês, nos comentários.",
   "legenda": "Pedido de *vocês,* nos *comentários.*",
   "segura": 0.3
  },
  {
   "fala": "Primeira noite: três da manhã, e a cidade acordada.",
   "legenda": "Primeira *noite:* três da *manhã,* e a cidade *acordada.*",
   "segura": 0.15
  },
  {
   "fala": "Um dia sem dormir, e o corpo fica como se tivesse bebido.",
   "legenda": "Um *dia* sem dormir, e o corpo fica como se tivesse *bebido.*",
   "segura": 0.15
  },
  {
   "fala": "Em três dias, o café esgota no mundo.",
   "legenda": "Em três *dias,* o café *esgota* no mundo.",
   "segura": 0.15
  },
  {
   "fala": "Em uma semana, os acidentes disparam. Os hospitais lotam.",
   "legenda": "Em uma *semana,* os acidentes *disparam.* Os hospitais *lotam.*",
   "segura": 0.15
  },
  {
   "fala": "Feito sem câmera. Comente guia e eu te mando.",
   "legenda": "Feito sem *câmera.* Comente *GUIA* e eu te mando.",
   "segura": 0.15
  },
  {
   "fala": "Em um mês, a economia despenca.",
   "legenda": "Em um *mês,* a economia *despenca.*",
   "segura": 0.15
  },
  {
   "fala": "No fim, oito bilhões de pessoas caem, como dominó.",
   "legenda": "No *fim,* oito *bilhões* de pessoas caem, como *dominó.*",
   "segura": 0.45
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, o sono nunca existiu.",
   "legenda": "Mas ninguém *reclama.* Para todo mundo, o ~sono~ *nunca existiu.*",
   "segura": 0.3
  },
  {
   "fala": "Só o Seu Nilo lembra. E ele anotou: dia oito, o sono.",
   "legenda": "Só o *Seu Nilo* lembra. E ele *anotou:* *dia 8,* o ~sono.~",
   "segura": 0.25
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "*Amanhã,* outra coisa vai *sumir.*"
  },
  {
   "fala": "Comente um para o aeroporto, dois para os apartamentos, três para a chuva, quatro para o pão de queijo, ou cinco para as fotos antigas.",
