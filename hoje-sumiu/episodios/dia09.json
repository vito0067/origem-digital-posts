 "falas": [
  {
   "fala": "Hoje sumiu os apartamentos.",
   "legenda": "Hoje sumiu os ~apartamentos.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo inteiro. Para *sempre.*"
  },
  {
   "fala": "Vocês decidiram que fosse apartamento.",
   "legenda": "*Vocês* decidiram que fosse *apartamento.*"
  },
  {
   "fala": "Primeira noite: ninguém tem onde dormir.",
   "legenda": "Primeira noite: ninguém tem onde *dormir.*"
  },
  {
   "fala": "O porteiro perde o emprego.",
   "legenda": "O *porteiro* perde o *emprego.*"
  },
  {
   "fala": "O vizinho de cima também some. Ninguém sente falta.",
   "legenda": "O vizinho de cima também *some.* Ninguém *sente falta.*"
  },
  {
   "fala": "Em uma semana, as praças viram acampamento.",
   "legenda": "Em uma semana, as *praças* viram *acampamento.*"
  },
  {
   "fala": "Em duas semanas, as imobiliárias fecham.",
   "legenda": "Em duas semanas, as *imobiliárias* fecham."
  },
  {
   "fala": "Feito sem câmera. Comente GUIA.",
   "legenda": "*Feito* sem *câmera.* Comente *GUIA.*"
  },
  {
   "fala": "Em um mês, os contratos somem.",
   "legenda": "Em um mês, os *contratos* somem."
  },
  {
   "fala": "Em dois meses, a construção para.",
   "legenda": "Em dois meses, a *construção* para."
  },
  {
   "fala": "No fim, só sobra céu.",
   "legenda": "No fim, só sobra *céu.*"
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, nunca existiram.",
   "legenda": "Mas ninguém reclama. Para todo mundo, *nunca existiram.*"
  },
  {
   "fala": "Só o Seu Nilo lembra. Ele anotou.",
   "legenda": "Só o *Seu Nilo* lembra. Ele *anotou.*"
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "Amanhã, outra coisa vai *sumir.*"
  },
  {
   "fala": "Comente um para o chuveiro quente, dois para os cachorros, três para a praia, quatro para os aniversários, ou cinco para as janelas.",
   "legenda": "Comente *1* para o *chuveiro quente,* *2* para os *cachorros,* *3* para a *praia,* *4* para os *aniversários,* ou *5* para as *janelas.*"
  }
