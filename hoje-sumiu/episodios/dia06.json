 "falas": [
  {
   "fala": "Hoje sumiu o uaifai.",
   "legenda": "Hoje sumiu o ~Wi-Fi.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo *inteiro.* Para *sempre.*",
   "segura": 0.2
  },
  {
   "fala": "Esse foi o comentário mais curtido. Tecnologia.",
   "legenda": "Esse foi o comentário *mais curtido.* *Tecnologia.*",
   "segura": 0.5
  },
  {
   "fala": "Primeiro, o telefone. A bolinha ficou girando para sempre.",
   "legenda": "Primeiro, o *telefone.* A bolinha ficou *girando* para *sempre.*",
   "segura": 0.3
  },
  {
   "fala": "Depois, a padaria. Só aceita dinheiro. E ninguém tem nota.",
   "legenda": "Depois, a *padaria.* Só aceita *dinheiro.* E ninguém tem *nota.*",
   "segura": 0.35
  },
  {
   "fala": "Em casa, a família descobriu que mora junto. Foi estranho.",
   "legenda": "Em casa, a *família* descobriu que mora *junto.* Foi *estranho.*",
   "segura": 0.4
  },
  {
   "fala": "Feito sem câmera. O guia está no línque da bio.",
   "legenda": "Feito sem *câmera.* O *guia* está no *link* da *bio.*",
   "segura": 0.2
  },
  {
   "fala": "Voltando. No prédio, o vizinho que pedia a senha agora pede açúcar.",
   "legenda": "Voltando. No prédio, o vizinho que *pedia* a senha agora *pede* *açúcar.*",
   "segura": 0.35
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, o uaifai nunca existiu.",
   "legenda": "Mas ninguém *reclama.* Para todo mundo, o ~Wi-Fi~ *nunca existiu.*",
   "segura": 0.4
  },
  {
   "fala": "Só o Seu Nilo lembra. Aqui não some governo nem pessoa. E ele anotou: dia seis, o uaifai.",
   "legenda": "Só o *Seu Nilo* lembra. Aqui não some *governo* nem *pessoa.* E ele *anotou:* *dia 6,* o ~Wi-Fi.~",
   "segura": 0.35
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
