 "falas": [
  {
   "fala": "Hoje sumiu os veículos.",
   "legenda": "Hoje sumiu os ~veículos.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo *inteiro.* Para *sempre.*",
   "segura": 0.2
  },
  {
   "fala": "Ontem eu errei. O mais curtido era veículos, não o uaifai. Hoje eu conserto.",
   "legenda": "Ontem eu *errei.* O mais curtido era *veículos,* não o ~Wi-Fi.~ Hoje eu *conserto.*",
   "segura": 0.5
  },
  {
   "fala": "Primeiro, o ônibus. O ponto virou um clube de amigos esperando.",
   "legenda": "Primeiro, o *ônibus.* O ponto virou um clube de amigos *esperando.*",
   "segura": 0.3
  },
  {
   "fala": "Depois, a pizza. Chegou a pé, quatro horas depois, e fria.",
   "legenda": "Depois, a *pizza.* Chegou a pé, quatro *horas* depois, e *fria.*",
   "segura": 0.35
  },
  {
   "fala": "No fim, só sobrou o cavalo do Seu Zé. Agora ele cobra pedágio.",
   "legenda": "No fim, só sobrou o *cavalo* do Seu Zé. Agora ele cobra *pedágio.*",
   "segura": 0.4
  },
  {
   "fala": "Quer saber como é feito? Comente guia.",
   "legenda": "Quer saber como é *feito?* Comente *GUIA.*",
   "segura": 0.2
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, os veículos nunca existiram.",
   "legenda": "Mas ninguém *reclama.* Para todo mundo, os ~veículos~ *nunca existiram.*",
   "segura": 0.4
  },
  {
   "fala": "Só o Seu Nilo lembra. Aqui não some governo nem pessoa. E ele anotou: dia sete, os veículos.",
   "legenda": "Só o *Seu Nilo* lembra. Aqui não some *governo* nem *pessoa.* E ele *anotou:* *dia 7,* os ~veículos.~",
   "segura": 0.35
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "*Amanhã,* outra coisa vai *sumir.*"
  },
  {
   "fala": "Quem escolhe é você. Comente um número ou escreva a sua ideia: um para a chuva, dois para o pão de queijo, três para o despertador, quatro para as fotos antigas, ou cinco para a sombra das árvores.",
