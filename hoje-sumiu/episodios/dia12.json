 "falas": [
  {
   "fala": "Hoje sumiu a cor azul.",
   "legenda": "Hoje sumiu a cor ~azul.~"
  },
  {
   "fala": "Do mundo inteiro. Para sempre.",
   "legenda": "Do mundo inteiro. Para *sempre.*"
  },
  {
   "fala": "O comentário mais curtido foi a cor azul.",
   "legenda": "O comentário mais *curtido* foi a cor *azul.*"
  },
  {
   "fala": "Primeira manhã: o céu amanhece cinza.",
   "legenda": "Primeira manhã: o *céu* amanhece *cinza.*"
  },
  {
   "fala": "Ninguém sabe se vai chover.",
   "legenda": "Ninguém sabe se vai *chover.*"
  },
  {
   "fala": "O mar perde a graça.",
   "legenda": "O *mar* perde a *graça.*"
  },
  {
   "fala": "Em uma semana, a caneta azul vira só caneta.",
   "legenda": "Em uma semana, a *caneta* azul vira só *caneta.*"
  },
  {
   "fala": "Em duas semanas, o pintor não consegue mais fazer verde.",
   "legenda": "Em duas semanas, o *pintor* não consegue mais fazer *verde.*"
  },
  {
   "fala": "Feito sem câmera. Comente GUIA.",
   "legenda": "*Feito* sem *câmera.* Comente *GUIA.*"
  },
  {
   "fala": "Em um mês, toda calça azul vira calça cinza.",
   "legenda": "Em um mês, toda *calça* azul vira calça *cinza.*"
  },
  {
   "fala": "Em três meses, a arara azul vira só arara.",
   "legenda": "Em três meses, a *arara* azul vira só *arara.*"
  },
  {
   "fala": "No fim, ninguém mais diz que está tudo azul.",
   "legenda": "No fim, ninguém mais diz que está *tudo* *azul.*"
  },
  {
   "fala": "Mas ninguém reclama. Para todo mundo, azul nunca existiu.",
   "legenda": "Mas ninguém reclama. Para todo mundo, azul *nunca existiu.*"
  },
  {
   "fala": "Só o Seu Nilo lembra. Ele anotou.",
   "legenda": "Só o *Seu Nilo* lembra. Ele *anotou.*",
   "segura": 1.4
  },
  {
   "fala": "Amanhã, outra coisa vai sumir.",
   "legenda": "Amanhã, outra coisa vai *sumir.*"
  },
  {
   "fala": "Quem escolhe é você. Comente o que some amanhã. O mais curtido decide.",
