 "falas": [
  { "fala": "Hoje sumiu o boleto.", "legenda": "Hoje sumiu o ~boleto.~" },
  { "fala": "Do mundo inteiro. Para sempre.", "legenda": "Do mundo *inteiro.* Para *sempre.*", "segura": 0.2 },
  { "fala": "Esse foi o comentário mais curtido que valia.", "legenda": "Esse foi o comentário *mais curtido* que *valia.*", "segura": 0.5 },
  { "fala": "No começo, é festa. Nunca mais conta na porta. Nunca mais código de barras.", "legenda": "No começo, é *festa.* Nunca mais *conta* na porta. Nunca mais código de *barras.*" },
  { "fala": "Mas a conta de luz vinha num boleto. Ninguém consegue pagar. E a empresa desliga a sua rua inteira.", "legenda": "Mas a conta de *luz* vinha num ~boleto.~ Ninguém consegue *pagar.* E a empresa *desliga* a sua rua *inteira.*", "segura": 0.4 },
  { "fala": "Então o mercado volta a vender fiado. O caderninho cresce todo dia. Já está maior que o mercado.", "legenda": "Então o *mercado* volta a vender *fiado.* O *caderninho* cresce todo dia. Já está *maior* que o mercado.", "segura": 0.3 },
  { "fala": "O síndico agora cobra de porta em porta. Às seis da manhã. Em voz alta.", "legenda": "O *síndico* agora cobra de porta em *porta.* Às *seis* da manhã. Em voz *alta.*", "segura": 0.3 },
  { "fala": "Este vídeo foi feito só com inteligência artificial, sem câmera. Quer aprender? O guia está no línque da bio.", "legenda": "Este vídeo foi feito só com *inteligência artificial,* sem *câmera.* Quer *aprender?* O *guia* está no *link* da *bio.*", "segura": 0.2 },
  { "fala": "Voltando. Sem boleto, o Brasil volta para a troca. A mensalidade da escola agora custa duas galinhas.", "legenda": "Voltando. Sem ~boleto,~ o Brasil volta para a *troca.* A *mensalidade* da escola agora custa duas *galinhas.*", "segura": 0.45 },
  { "fala": "Só uma coisa não mudou. Seu cunhado continua te devendo cinquenta reais.", "legenda": "Só uma coisa não *mudou.* Seu *cunhado* continua te *devendo* cinquenta *reais.*", "segura": 0.55 },
  { "fala": "Mas o mais estranho é que ninguém reclama. Para todo mundo, o boleto nunca existiu.", "legenda": "Mas o mais *estranho* é que ninguém reclama. Para todo mundo, o ~boleto~ *nunca existiu.*", "segura": 0.4 },
  { "fala": "Só o Seu Nilo lembra. A regra dele é clara: aqui não some governo nem pessoa. E ele anotou: dia três, o boleto.", "legenda": "Só o *Seu Nilo* lembra. A regra dele é clara: aqui não some *governo* nem *pessoa.* E ele anotou: *dia 3,* o ~boleto.~", "segura": 0.35 },
  { "fala": "Amanhã, outra coisa vai sumir. E quem escolhe é você.", "legenda": "*Amanhã,* outra coisa vai sumir. E quem escolhe é *você.*" },
  { "fala": "Comenta aqui embaixo. O comentário mais curtido some do mundo.", "legenda": "*Comenta* aqui embaixo. O comentário mais curtido *some* do mundo." }
 ],
